# Java 后端（ops_agent）环境变量示例
# 复制为 .env 或在启动时注入。

# MySQL
MYSQL_URL=jdbc:mysql://localhost:3306/agent_platform?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_password

# 内部通信令牌（与 aiops-agent/.env 的 JAVA_INTERNAL_TOKEN 一致）
OPSAGENT_INTERNAL_TOKEN=dev-internal-token

# Alertmanager Webhook 认证令牌（Alertmanager 的 http_config.headers 同步配置）
OPSAGENT_WEBHOOK_TOKEN=dev-webhook-token

# 可选：HMAC 签名密钥（留空表示不启用）
OPSAGENT_WEBHOOK_HMAC_SECRET=

# AI 大脑地址
OPSAGENT_AGENT_URL=http://localhost:5000
