# Python AI 大脑（aiops-agent）环境变量示例
# 复制为 .env 后按需修改。不要在 .env.example 中填写真实密钥。

# LLM 与向量库
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# 向量库 embedding 专用（阿里云百炼 DashScope 原生接口，与 LLM 无关）
# DeepSeek 没有 /embeddings，所以 embedding 走独立通道。
DASHSCOPE_API_KEY=your-dashscope-api-key-here
EMBEDDING_MODEL=qwen3.7-text-embedding-flash

# Java 后端地址
JAVA_BASE_URL=http://localhost:8081

# 内部共享密钥（与 Java 侧 opsagent.internal.token 一致）
JAVA_INTERNAL_TOKEN=dev-internal-token

# 超时与迭代
AGENT_TIMEOUT_SECONDS=300
AGENT_MAX_ITERATIONS=8
HTTP_READ_TIMEOUT=60

# 主动巡检
# HEALTH_CHECK_ENABLED=false 关闭定时巡检
# HEALTH_CHECK_INTERVAL_HOURS>0 按该间隔周期性巡检（如 1 小时一次），默认 -1 为每天 8:00
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_HOURS=-1

# 向量库开关（true 启用 RAG，false 跳过构建）
RAG_ENABLED=true

# ---------- 工业级 RAG 增强 ----------
# Query 润色：用便宜模型把口语化提问改写成标准检索 Query
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_MODEL=qwen-turbo
QUERY_REWRITE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QUERY_REWRITE_API_KEY=your-dashscope-api-key-here

# 混合检索：BM25 关键词 + 向量双路召回，RRF 融合
RAG_BM25_ENABLED=true
RAG_RRF_K=60

# Rerank 精排：RRF Top20 -> 精排 Top3
RERANK_ENABLED=true
RERANK_MODEL=gte-rerank
RERANK_TOP_K=3

# ---------- LangFuse 可观测性 ----------
# docker compose -f docker-compose.langfuse.yml up -d 启动后，
# 在 http://localhost:3030 创建 project 拿 public/secret key
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3030

# LangFuse 容器自身密钥（docker compose 用，请部署时生成随机值）
#   openssl rand -base64 32   -> NEXTAUTH_SECRET / SALT
#   openssl rand -hex 32      -> ENCRYPTION_KEY
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# LangFuse v3 ClickHouse（compose 必须显式配置）
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=default

# LangFuse v3 MinIO/S3 对象存储
# compose 首次启动会自动创建 S3_BUCKET（langfuse-minio-init）
MINIO_ROOT_USER=aiops-minio-admin
MINIO_ROOT_PASSWORD=
S3_BUCKET=langfuse
S3_REGION=us-east-1

# ---------- AgentState（断点续传/审批恢复）----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---------- Reflection 防幻觉 ----------
REFLECTION_ENABLED=true
REFLECTION_MODEL=qwen-turbo
REFLECTION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
REFLECTION_API_KEY=your-dashscope-api-key-here
