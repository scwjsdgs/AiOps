# Python AI 大脑（aiops-agent）环境变量示例
# 复制为 .env 后按需修改。不要在 .env.example 中填写真实密钥。

# LLM 与向量库
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# Java 后端地址
JAVA_BASE_URL=http://localhost:8081

# 内部共享密钥（与 Java 侧 opsagent.internal.token 一致）
JAVA_INTERNAL_TOKEN=dev-internal-token

# 超时与迭代
AGENT_TIMEOUT_SECONDS=300
AGENT_MAX_ITERATIONS=8
HTTP_READ_TIMEOUT=60

# 向量库开关（true 启用 RAG，false 跳过构建）
RAG_ENABLED=false