# Python AI 大脑（aiops-agent）环境变量示例
# 复制为 .env 后按需修改。不要在 .env.example 中填写真实密钥。

# LLM 与向量库
# 主对话/Agent/润色/评测统一使用 DeepSeek；embedding/rerank 仍用 DashScope。
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash

# 向量库 embedding 专用（阿里云百炼 DashScope 原生接口，与 LLM 无关）
# DeepSeek 没有 /embeddings，所以 embedding 走独立通道。
DASHSCOPE_API_KEY=your-dashscope-api-key-here
EMBEDDING_MODEL=qwen3.7-text-embedding-flash

# Java 后端地址
JAVA_BASE_URL=http://localhost:8081

# 内部共享密钥（与 Java 侧 opsagent.internal.token 一致）
JAVA_INTERNAL_TOKEN=dev-internal-token

# 工具调用链双通道模式：kafka（默认）走 Kafka 事件驱动，http 走原 HTTP 回调
# Kafka 启动失败/发送失败/结果超时均自动降级 HTTP
CALLBACK_MODE=kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOOL_REQUEST_TOPIC=agent-tool-request
KAFKA_TOOL_RESULT_TOPIC=agent-tool-result
KAFKA_GROUP_ID=aiops-python-tool-group
KAFKA_CALLBACK_TIMEOUT_SECONDS=30

# 超时与迭代
AGENT_TIMEOUT_SECONDS=300
AGENT_MAX_ITERATIONS=8
HTTP_READ_TIMEOUT=60

# 主动巡检
# HEALTH_CHECK_ENABLED=false 关闭定时巡检
# HEALTH_CHECK_INTERVAL_HOURS>0 按该间隔周期性巡检（如 1 小时一次），默认 -1 为每天 8:00
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_HOURS=-1

# 向量库开关（true 启用 RAG，false 跳过构建）
RAG_ENABLED=true

# ---------- 工业级 RAG 增强 ----------
# Query 润色：与主模型同通道（DeepSeek），降低多供应商限流与成本
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_MODEL=deepseek-flash
QUERY_REWRITE_BASE_URL=https://api.deepseek.com/v1
QUERY_REWRITE_API_KEY=your-api-key-here

# 混合检索：BM25 关键词 + 向量双路召回，RRF 融合
RAG_BM25_ENABLED=true
RAG_RRF_K=60

# Rerank 精排：RRF Top20 -> 精排 Top3
RERANK_ENABLED=true
RERANK_MODEL=gte-rerank
RERANK_TOP_K=3

# ---------- LangFuse 可观测性 ----------
# docker compose -f docker-compose.langfuse.yml up -d 启动后，
# 在 http://localhost:3030 创建 project 拿 public/secret key
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3030

# LangFuse 容器自身密钥（docker compose 用，请部署时生成随机值）
#   openssl rand -base64 32   -> NEXTAUTH_SECRET / SALT
#   openssl rand -hex 32      -> ENCRYPTION_KEY
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# LangFuse v3 ClickHouse（compose 必须显式配置）
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=default

# LangFuse v3 MinIO/S3 对象存储
# compose 首次启动会自动创建 S3_BUCKET（langfuse-minio-init）
MINIO_ROOT_USER=aiops-minio-admin
MINIO_ROOT_PASSWORD=
S3_BUCKET=langfuse
S3_REGION=us-east-1

# ---------- LangGraph Checkpointer（断点续传/审批恢复）----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# 挂起的审批/任务最长可恢复时间（秒），默认 24h
GRAPH_CHECKPOINT_TTL_SECONDS=86400

# ---------- Reflection 防幻觉 ----------
REFLECTION_ENABLED=true
REFLECTION_MODEL=deepseek-flash
REFLECTION_BASE_URL=https://api.deepseek.com/v1
REFLECTION_API_KEY=your-api-key-here

# ---------- LLM 成本与预算（cost_tracker.py） ----------
# 每天超过该预算（USD）后在 /api/llm/cost 输出预算告警
LLM_DAILY_BUDGET_USD=5.0
# LLM 缓存 TTL（秒）
LLM_CACHE_TTL_SECONDS=3600

# ---------- 子图封装 + 防死循环 ----------
# LangGraph 图总步数硬闸门（recursion_limit），条件边之外的最后一道防线
GRAPH_RECURSION_LIMIT=40
# 主流程条件边允许的最大迭代轮数（iteration_count 达到后强制进报告子图收束）
MAX_ITERATION_ROUNDS=6

# ---------- Token 优化：消息滑动窗口 ----------
# 每个 Worker 子图批次保留的最近消息条数，用 langchain trim_messages 裁剪
MESSAGES_WINDOW_SIZE=12
# trim_messages 的近似 token 上限（长日志/多轮对话超过后压缩）
TRIM_MESSAGES_MAX_TOKENS=4000

# ---------- Send API 多 Pod 并发诊断 ----------
# 并行诊断最大并发数，编译图/运行时通过 max_concurrency 生效，防止打爆 K8s API
PARALLEL_POD_DIAGNOSIS_MAX_CONCURRENCY=5
